{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://buildstream.graph-toolkit/schema/graph_data.schema.json",
  "title": "BuildStream Graph Data",
  "description": "Schema for BuildStream dependency graph export format",
  "type": "object",
  "required": ["metadata", "nodes", "edges", "combos"],
  "properties": {
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    },
    "combos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Combo"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "target",
        "totalNodes",
        "totalEdges",
        "globalCriticalPathLength",
        "maxTopoLayer",
        "maxConcurrencyWidth",
        "density",
        "levelCounts",
        "kindColorMap",
        "depTypeColorMap",
        "heatmapGradient",
        "hasCycles",
        "layoutPrecomputed",
        "reachabilityMode",
        "bottleneckMetric",
        "articulationSemantics",
        "graphSizeClass"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Schema version in semver format"
        },
        "target": {
          "type": "string",
          "description": "BuildStream target element"
        },
        "totalNodes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of nodes in the graph"
        },
        "totalEdges": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of edges in the graph"
        },
        "globalCriticalPathLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of the global critical path"
        },
        "maxTopoLayer": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum topological layer"
        },
        "maxConcurrencyWidth": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum concurrency width"
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "description": "Graph density"
        },
        "maxBlastRadius": {
          "oneOf": [
            {"type": "integer"},
            {"type": "null"}
          ],
          "description": "Maximum blast radius across all nodes (null if not computed)"
        },
        "maxBuildCost": {
          "oneOf": [
            {"type": "integer"},
            {"type": "null"}
          ],
          "description": "Maximum build cost across all nodes (null if not computed)"
        },
        "maxBottleneckScore": {
          "oneOf": [
            {"type": "number"},
            {"type": "null"}
          ],
          "description": "Maximum bottleneck score across all nodes (null if not computed)"
        },
        "levelCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Node counts per topological layer"
        },
        "kindColorMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping of node kind to color"
        },
        "depTypeColorMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping of dependency type to color"
        },
        "heatmapGradient": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Color gradient for heatmap visualization"
        },
        "hasCycles": {
          "type": "boolean",
          "description": "Whether the graph contains cycles"
        },
        "layoutPrecomputed": {
          "type": "boolean",
          "description": "Whether layout was precomputed by the extractor"
        },
        "reachabilityMode": {
          "type": "string",
          "enum": ["exact", "targeted", "disabled_by_user", "disabled_memory_budget", "disabled_timeout"],
          "description": "Mode of reachability computation"
        },
        "bottleneckMetric": {
          "type": "string",
          "enum": ["approximate", "exact", "disabled"],
          "description": "Type of bottleneck metric computation"
        },
        "bottleneckSamples": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ],
          "description": "Number of samples used for approximate betweenness (null if exact or disabled)"
        },
        "articulationSemantics": {
          "type": "string",
          "enum": ["undirected_projection"],
          "description": "Semantics of articulation point computation"
        },
        "graphSizeClass": {
          "type": "string",
          "enum": ["normal", "large", "huge", "extreme", "ultra"],
          "description": "Classification of graph size"
        },
        "performance": {
          "$ref": "#/definitions/Performance"
        },
        "analysisModes": {
          "$ref": "#/definitions/AnalysisModes"
        }
      },
      "additionalProperties": false
    },
    "Performance": {
      "type": "object",
      "required": [
        "parseMs",
        "graphConstructionMs",
        "sccMs",
        "reachabilityMs",
        "criticalPathMs",
        "betweennessMs",
        "articulationMs",
        "layoutMs",
        "serializationMs",
        "totalMs",
        "peakMemoryMb",
        "maxReachabilityMemoryMb",
        "targetedReachabilityK",
        "metricTimeoutSeconds"
      ],
      "properties": {
        "parseMs": {"type": "number", "minimum": 0},
        "graphConstructionMs": {"type": "number", "minimum": 0},
        "sccMs": {"type": "number", "minimum": 0},
        "reachabilityMs": {"type": "number", "minimum": 0},
        "criticalPathMs": {"type": "number", "minimum": 0},
        "betweennessMs": {"type": "number", "minimum": 0},
        "articulationMs": {"type": "number", "minimum": 0},
        "layoutMs": {"type": "number", "minimum": 0},
        "serializationMs": {"type": "number", "minimum": 0},
        "totalMs": {"type": "number", "minimum": 0},
        "peakMemoryMb": {"type": "number", "minimum": 0},
        "maxReachabilityMemoryMb": {"type": "number", "minimum": 0},
        "targetedReachabilityK": {"type": "integer", "minimum": 0},
        "metricTimeoutSeconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "AnalysisModes": {
      "type": "object",
      "required": ["reachability", "betweenness", "articulation", "layout"],
      "properties": {
        "reachability": {
          "type": "string",
          "enum": ["exact", "targeted", "disabled_by_user", "disabled_memory_budget", "disabled_timeout"]
        },
        "betweenness": {
          "type": "string",
          "enum": ["approximate", "exact", "disabled", "disabled_timeout"]
        },
        "articulation": {
          "type": "string",
          "enum": ["exact", "approximate", "disabled", "disabled_timeout"]
        },
        "layout": {
          "type": "string",
          "enum": ["graphviz", "none"]
        }
      },
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "required": ["id", "type", "combo", "x", "y", "data", "style"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier (file path)"
        },
        "type": {
          "type": "string",
          "enum": ["rect", "circle", "ellipse"],
          "description": "Node shape type"
        },
        "combo": {
          "type": "string",
          "description": "Parent combo ID (omitted for root-level nodes)"
        },
        "x": {
          "type": "number",
          "description": "X coordinate"
        },
        "y": {
          "type": "number",
          "description": "Y coordinate"
        },
        "data": {
          "$ref": "#/definitions/NodeData"
        },
        "style": {
          "$ref": "#/definitions/NodeStyle"
        }
      },
      "additionalProperties": false
    },
    "NodeData": {
      "type": "object",
      "required": [
        "label",
        "kind",
        "sccId",
        "inDegree",
        "outDegree",
        "topoLayer",
        "cpDepth",
        "cpHeight",
        "isCritical",
        "isArticulationPoint",
        "isCycle"
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "Display label for the node"
        },
        "kind": {
          "type": "string",
          "description": "Element kind (build, import, compose, script, etc.)"
        },
        "sccId": {
          "oneOf": [
            {"type": "integer"},
            {"type": "null"}
          ],
          "description": "Strongly connected component ID (null if not in a cycle)"
        },
        "inDegree": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of incoming edges"
        },
        "outDegree": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of outgoing edges"
        },
        "topoLayer": {
          "type": "integer",
          "minimum": 0,
          "description": "Topological layer"
        },
        "cpDepth": {
          "type": "integer",
          "minimum": 0,
          "description": "Critical path depth from sources"
        },
        "cpHeight": {
          "type": "integer",
          "minimum": 0,
          "description": "Critical path height to sinks"
        },
        "blastRadius": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ],
          "description": "Number of distinct downstream reachable nodes (null if not computed)"
        },
        "buildCost": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ],
          "description": "Number of distinct upstream reachable nodes (null if not computed)"
        },
        "bottleneckScore": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ],
          "description": "Betweenness centrality normalized to [0,1] (null if not computed)"
        },
        "isCritical": {
          "type": "boolean",
          "description": "Whether this node is on the critical path"
        },
        "isArticulationPoint": {
          "type": "boolean",
          "description": "Whether this node is an articulation point"
        },
        "isCycle": {
          "type": "boolean",
          "description": "Whether this node participates in a cycle"
        }
      },
      "additionalProperties": false
    },
    "NodeStyle": {
      "type": "object",
      "required": ["size", "fill", "stroke", "lineWidth"],
      "properties": {
        "size": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] of the node"
        },
        "fill": {
          "type": "string",
          "description": "Fill color"
        },
        "stroke": {
          "type": "string",
          "description": "Stroke color"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "description": "Stroke width"
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["id", "type", "source", "target", "data", "style"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique edge identifier"
        },
        "type": {
          "type": "string",
          "enum": ["cubic-horizontal", "cubic-vertical", "line", "loop"],
          "description": "Edge shape type"
        },
        "source": {
          "type": "string",
          "description": "Source node ID"
        },
        "target": {
          "type": "string",
          "description": "Target node ID"
        },
        "data": {
          "$ref": "#/definitions/EdgeData"
        },
        "style": {
          "$ref": "#/definitions/EdgeStyle"
        }
      },
      "additionalProperties": false
    },
    "EdgeData": {
      "type": "object",
      "required": ["depType", "isCritical"],
      "properties": {
        "depType": {
          "type": "string",
          "enum": ["build", "runtime", "both"],
          "description": "Type of dependency"
        },
        "isCritical": {
          "type": "boolean",
          "description": "Whether this edge is on the critical path"
        }
      },
      "additionalProperties": false
    },
    "EdgeStyle": {
      "type": "object",
      "required": ["stroke", "endArrow", "opacity", "lineWidth"],
      "properties": {
        "stroke": {
          "type": "string",
          "description": "Stroke color"
        },
        "endArrow": {
          "type": "boolean",
          "description": "Whether to show arrow head"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Edge opacity"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "description": "Edge stroke width"
        }
      },
      "additionalProperties": false
    },
    "Combo": {
      "type": "object",
      "required": ["id", "type", "data", "style"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique combo identifier"
        },
        "type": {
          "type": "string",
          "enum": ["rect", "circle", "ellipse"],
          "description": "Combo shape type"
        },
        "combo": {
          "type": "string",
          "description": "Parent combo ID (omitted for root combos)"
        },
        "data": {
          "$ref": "#/definitions/ComboData"
        },
        "style": {
          "$ref": "#/definitions/ComboStyle"
        }
      },
      "additionalProperties": false
    },
    "ComboData": {
      "type": "object",
      "required": [
        "label",
        "nodeCount",
        "minTopoLayer",
        "maxTopoLayer",
        "hasCritical"
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "Display label for the combo"
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of nodes in this combo"
        },
        "minTopoLayer": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum topological layer among members"
        },
        "maxTopoLayer": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum topological layer among members"
        },
        "maxBlastRadius": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ],
          "description": "Maximum blast radius among members (null if all members have null)"
        },
        "maxBuildCost": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ],
          "description": "Maximum build cost among members (null if all members have null)"
        },
        "maxBottleneckScore": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ],
          "description": "Maximum bottleneck score among members (null if all members have null)"
        },
        "hasCritical": {
          "type": "boolean",
          "description": "Whether this combo contains any critical nodes"
        }
      },
      "additionalProperties": false
    },
    "ComboStyle": {
      "type": "object",
      "required": ["fill", "stroke", "collapsedSize"],
      "properties": {
        "fill": {
          "type": "string",
          "description": "Fill color"
        },
        "stroke": {
          "type": "string",
          "description": "Stroke color"
        },
        "collapsedSize": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] when collapsed"
        }
      },
      "additionalProperties": false
    }
  }
}
